# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5183

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/smart-travel

# Auth
JWT_SECRET=change-me-to-something-long-and-random
JWT_EXPIRES_IN=7d

# External APIs (all optional)
# Weather uses Open-Meteo which needs no key.
# If set, travel times between activities come from Google Directions instead of the built-in estimate.
GOOGLE_MAPS_API_KEY=
