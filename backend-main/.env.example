# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5183

# Database
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Stripe Identity (optional; required for identity verification and matching)
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
STRIPE_IDENTITY_RETURN_URL=

# External APIs (all optional)
# Weather uses Open-Meteo which needs no key.
# If set, travel times between activities come from Google Directions instead of the built-in estimate.
GOOGLE_MAPS_API_KEY=
